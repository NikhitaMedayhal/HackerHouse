const shareToX = async () => {
  try {
    const blob = await capturePassportBlob();

    if (!blob) {
      alert("Could not generate your passport image.");
      return;
    }

    // =========================
    // 1. Upload passport to Cloudinary
    // =========================

    const formData = new FormData();

    formData.append("file", blob, "builder-passport.png");
    formData.append("upload_preset", CLOUDINARY_UPLOAD_PRESET);

    const response = await fetch(
      `https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/image/upload`,
      {
        method: "POST",
        body: formData,
      }
    );

    const responseText = await response.text();

    if (!response.ok) {
      let detail = responseText;

      try {
        const parsed = JSON.parse(responseText);
        detail = parsed?.error?.message || responseText;
      } catch {
        // Keep original response
      }

      throw new Error(
        `Cloudinary upload failed (${response.status}): ${detail}`
      );
    }

    const data = JSON.parse(responseText);

    const imageUrl = data.secure_url as string;

    // =========================
    // 2. Create a unique share ID
    // =========================

    const shareId = generateShareId();

    // =========================
    // 3. Build public share page
    // =========================

    const shareUrl =
      `${window.location.origin}/share/${shareId}` +
      `?image=${encodeURIComponent(imageUrl)}`;

    // =========================
    // 4. Open X
    // =========================

    const xUrl =
      `https://x.com/intent/post?text=` +
      encodeURIComponent(
        `${TWEET_MESSAGE}\n\n${shareUrl}`
      );

    window.open(xUrl, "_blank", "noopener,noreferrer");

  } catch (error) {
    console.error(error);

    const message =
      error instanceof Error
        ? error.message
        : "Unknown error";

    alert(
      `Something went wrong while preparing your passport:\n\n${message}`
    );
  }

  UPSTASH_REDIS_REST_URL= https://noble-mole-181726.upstash.io 
